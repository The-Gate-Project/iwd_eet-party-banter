// Xan

	ACTION_IF (FILE_EXISTS_IN_GAME ~7XXANJ.dlg~) BEGIN
		// Dialog
		COPY ~weidu_external/iwd_eet-party-banter/Dialogue/Interject.d~	~weidu_external/iwd_eet-party-banter/Dialogue/Interject.d~
			REPLACE_TEXTUALLY ~// BG1inBG2 == 7XXANJ~ ~== 7XXANJ~

		// Scripts 7XXAN
		EXTEND_TOP ~ID4001.bcs~ ~iwd_eet-party-banter/Party-banter_for-all/7XXAN/ID4001.baf~

				PRINT ~
				Xan : BG1 NPC in BG2 (Smiling Imp and Austin) is installed
				~
				
	END

	ACTION_IF (FILE_EXISTS_IN_GAME ~O#XANJ.dlg~) BEGIN
		// Dialog
		COPY ~weidu_external/iwd_eet-party-banter/Dialogue/Interject.d~	~weidu_external/iwd_eet-party-banter/Dialogue/Interject.d~
			REPLACE_TEXTUALLY ~// Xan for BG2 == O#XANJ~ ~== O#XANJ~

		// Scripts
		EXTEND_TOP ~ID4001.bcs~ ~iwd_eet-party-banter/Party-banter_for-all/O#XAN/ID4001.baf~

				PRINT ~
				Xan : for BG2 (Kulyok) is installed
				~
	END

