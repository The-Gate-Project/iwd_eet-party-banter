// Skie / Eldoth

	ACTION_IF (FILE_EXISTS_IN_GAME ~7XEldoJ.dlg~) AND (FILE_EXISTS_IN_GAME ~7XSkiJ.dlg~) BEGIN
		// Dialog
			COPY ~weidu_external/iwd_eet-party-banter/Dialogue/Interject.d~	~weidu_external/iwd_eet-party-banter/Dialogue/Interject.d~
				REPLACE_TEXTUALLY ~// BG1inBG2 == 7XSkiJ~ ~== 7XSkiJ~
				REPLACE_TEXTUALLY ~// BG1inBG2 == 7XEldoJ~ ~== 7XEldoJ~

		// Scripts Skie 7XSKI
		COPY ~iwd_eet-party-banter/Scripts/ID1007.baf~ ~weidu_external/iwd_eet-party-banter/Scripts/7XSKI/ID1007.baf~
			REPLACE_TEXTUALLY ~"Skie"~ ~"7XSKI"~
		EXTEND_TOP ~ID1007.bcs~ ~weidu_external/iwd_eet-party-banter/Scripts/7XSKI/ID1007.baf~
		
		COPY ~iwd_eet-party-banter/Scripts/ID2113.baf~ ~weidu_external/iwd_eet-party-banter/Scripts/7XSKI/ID2113.baf~
			REPLACE_TEXTUALLY ~"Skie"~ ~"7XSKI"~
		EXTEND_TOP ~ID2113.bcs~ ~weidu_external/iwd_eet-party-banter/Scripts/7XSKI/ID2113.baf~

		// Scripts Eldoth 7XELDOT
		COPY ~iwd_eet-party-banter/Scripts/ID2114.baf~ ~weidu_external/iwd_eet-party-banter/Scripts/7XELDOT/ID2114.baf~
			REPLACE_TEXTUALLY ~"Eldoth"~ ~"7XELDOT~
		EXTEND_TOP ~ID2114.bcs~ ~weidu_external/iwd_eet-party-banter/Scripts/7XELDOT/ID2114.baf~
		
		COPY ~iwd_eet-party-banter/Scripts/ID9101.baf~ ~weidu_external/iwd_eet-party-banter/Scripts/7XELDOT/ID9101.baf~
			REPLACE_TEXTUALLY ~"Eldoth"~ ~"7XELDOT~
		EXTEND_TOP ~ID9101.bcs~ ~weidu_external/iwd_eet-party-banter/Scripts/7XELDOT/ID9101.baf~

				PRINT ~
				Skie and Eldoth : BG1 NPC in BG2 (Smiling Imp and Austin) are installed
				~
	END

