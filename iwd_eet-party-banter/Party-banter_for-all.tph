// Skie / Eldoth

	ACTION_IF (FILE_EXISTS_IN_GAME ~7XEldoJ.dlg~) AND (FILE_EXISTS_IN_GAME ~7XSkiJ.dlg~) BEGIN
		// Dialog
			COPY ~weidu_external/iwd_eet-party-banter/Dialogue/Interject.d~	~weidu_external/iwd_eet-party-banter/Dialogue/Interject.d~
				REPLACE_TEXTUALLY ~// BG1inBG2 == 7XSkiJ~ ~== 7XSkiJ~
				REPLACE_TEXTUALLY ~// BG1inBG2 == 7XEldoJ~ ~== 7XEldoJ~

		// Scripts Skie 7XSKI
		EXTEND_TOP ~ID1007.bcs~ ~iwd_eet-party-banter/Party-banter_for-all/7XSKI/ID1007.baf~
		EXTEND_TOP ~ID2113.bcs~ ~iwd_eet-party-banter/Party-banter_for-all/7XSKI/ID2113.baf~

		// Scripts Eldoth 7XELDOT
		EXTEND_TOP ~ID2114.bcs~ ~iwd_eet-party-banter/Party-banter_for-all/7XELDOT/ID2114.baf~
		EXTEND_TOP ~ID9101.bcs~ ~iwd_eet-party-banter/Party-banter_for-all/7XELDOT/ID9101.baf~

				PRINT ~
				Skie and Eldoth : BG1 NPC in BG2 (Smiling Imp and Austin) are installed
				~
	END

