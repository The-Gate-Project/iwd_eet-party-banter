BACKUP ~weidu_external/iwd_eet-party-banter/Backup~
AUTHOR ~AWizardDidIt~

VERSION ~v1.0~

ALWAYS

	ACTION_IF GAME_IS ~bgee~ BEGIN
		INCLUDE ~iwd_eet-party-banter/Lib/g3_bgee_cpmvars.tpa~
		PRINT ~Game is BGEE
		~
	END
	ACTION_IF GAME_IS ~eet~ BEGIN
		INCLUDE ~eet/other/cpmvars/eet_cpmvars.tpa~
		PRINT ~Game is EET
		~
	END
	ACTION_IF GAME_IS ~bg2ee~ BEGIN
			OUTER_SPRINT "IMOEN_JOINED" "IMOEN2J"
			OUTER_SPRINT "EDWIN_JOINED" "EDWINJ"
			OUTER_SPRINT "JAHEIRA_JOINED" "JAHEIRAJ"
			OUTER_SPRINT "MINSC_JOINED" "MINSCJ"
			OUTER_SPRINT "VICONIA_JOINED" "VICONIJ"
			OUTER_SPRINT "IMOEN_DV" "imoen2"
		PRINT ~Game is BG2EE
		~
	END
END

ALLOW_MISSING ~YOSHJ.dlg~
              ~ANOMENJ.dlg~
              ~HAERDAJ.dlg~
              ~KORGANJ.dlg~
              ~JANJ.dlg~
              ~VALYGARJ.dlg~
              ~AERIEJ.dlg~
              ~KELDORJ.dlg~
              ~HEXXATJ.dlg~
              ~MAZZYJ.dlg~
              ~CERNDJ.dlg~
              ~NALIAJ.dlg~
              ~SAREV25J.dlg~
              ~BAELOTHJ.dlg~
              ~DYNAHJ.dlg~
              ~KHALIJ.dlg~
              ~CORANJ.dlg~
              ~ELDOTJ.dlg~

AUTO_TRA ~iwd_eet-party-banter/Languages/%s~
AUTO_TRA ~iwd_eet-party-banter/Languages/%s/baf_tra~

LANGUAGE ~English~
         ~English~
         ~iwd_eet-party-banter/Languages/English/Setup-iwd_eet-party-banter.tra~

BEGIN @0
DESIGNATED 0
LABEL ~AWizardDidIt-party-banter~

ACTION_IF (MOD_IS_INSTALLED ~HOW_EET.TP2~ ~0~ OR MOD_IS_INSTALLED ~A7-TotLM-BG2EE.TP2~ ~0~ AND NOT MOD_IS_INSTALLED ~IWD1_EET.TP2~ ~1~) BEGIN
		INCLUDE ~iwd_eet-party-banter/Lib/iwd_eet-party-banter-HoW_EET-TotLM.tph~

	END ELSE ACTION_IF (MOD_IS_INSTALLED ~IWD1_EET.TP2~ ~0~ AND MOD_IS_INSTALLED ~IWD2_EET.TP2~ ~1~) BEGIN
		PRINT ~IWD1_EET and IWD2_EET are installed
		~

COMPILE EVALUATE_BUFFER ~iwd_eet-party-banter/Dialogue/Interject.d~

EXTEND_TOP ~ID1001.bcs~ ~iwd_eet-party-banter/Scripts/ID1001.baf~ // Yeslick
